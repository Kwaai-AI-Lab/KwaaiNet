[Unit]
Description=KwaaiNet Node
After=network.target

[Service]
# Both are `-`-prefixed so the one unit file serves .deb and .rpm alike.
EnvironmentFile=-/etc/default/kwaainet
EnvironmentFile=-/etc/sysconfig/kwaainet
ExecStart=/usr/bin/kwaainet run-node
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
