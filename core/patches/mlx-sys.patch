diff -ruN a/Cargo.toml b/Cargo.toml
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -18,6 +18,7 @@
     "David Chavez <david@dcvz.io>",
 ]
 build = "build.rs"
+links = "mlx"
 autolib = false
 autobins = false
 autoexamples = false
diff -ruN a/build.rs b/build.rs
--- a/build.rs
+++ b/build.rs
@@ -8,6 +8,10 @@
     let mut config = Config::new("src/mlx-c");
     config.very_verbose(true);
     config.define("CMAKE_INSTALL_PREFIX", ".");
+    // kwaai: kernels for macOS 14 (Metal 3.1) whatever SDK builds them.
+    let target = env::var("MLX_MACOS_DEPLOYMENT_TARGET").unwrap_or_else(|_| "14.0".into());
+    config.define("CMAKE_OSX_DEPLOYMENT_TARGET", &target);
+    println!("cargo:rerun-if-env-changed=MLX_MACOS_DEPLOYMENT_TARGET");
 
     #[cfg(debug_assertions)]
     {
@@ -36,10 +40,21 @@
     let dst = config.build();
 
     println!("cargo:rustc-link-search=native={}/build/lib", dst.display());
+    // kwaai: dependents read this as DEP_MLX_METALLIB to embed the kernels.
+    #[cfg(feature = "metal")]
+    println!("cargo:metallib={}/build/lib/mlx.metallib", dst.display());
     println!("cargo:rustc-link-lib=static=mlx");
     println!("cargo:rustc-link-lib=static=mlxc");
 
     println!("cargo:rustc-link-lib=c++");
+    // kwaai: @available checks need compiler-rt, which rustc does not link.
+    let rt = std::process::Command::new("xcrun")
+        .args(["clang", "--print-resource-dir"])
+        .output()
+        .expect("xcrun clang --print-resource-dir");
+    let rt = String::from_utf8(rt.stdout).unwrap();
+    println!("cargo:rustc-link-search=native={}/lib/darwin", rt.trim());
+    println!("cargo:rustc-link-lib=static=clang_rt.osx");
     println!("cargo:rustc-link-lib=dylib=objc");
     println!("cargo:rustc-link-lib=framework=Foundation");
 
diff -ruN a/src/mlx-c/CMakeLists.txt b/src/mlx-c/CMakeLists.txt
--- a/src/mlx-c/CMakeLists.txt
+++ b/src/mlx-c/CMakeLists.txt
@@ -35,7 +35,9 @@
   FetchContent_Declare(
     mlx
     GIT_REPOSITORY "https://github.com/ml-explore/mlx.git"
-    GIT_TAG v0.25.1)
+    GIT_TAG v0.25.1
+    # kwaai: lets the binary say where mlx.metallib is (patches/mlx-metallib.patch)
+    PATCH_COMMAND sh "${CMAKE_CURRENT_LIST_DIR}/kwaai-mlx-apply.sh")
   FetchContent_MakeAvailable(mlx)
 endif()
 
