+    /// KWAAI PATCH: multi-protocol support. The upgrade machinery already
+    /// negotiates every name in `protocol_names` (see the `UpgradeInfo` impl
+    /// below), but upstream removed the public setter, leaving no way to
+    /// serve a renamed network alongside the legacy name during a protocol
+    /// migration. An empty list is ignored: a kad with no protocols could
+    /// talk to nobody.
+    pub fn set_protocol_names(&mut self, names: Vec<StreamProtocol>) {
+        if !names.is_empty() {
+            self.protocol_names = names;
+        }
+    }
